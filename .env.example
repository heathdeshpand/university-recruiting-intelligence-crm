# ---------------------------------------------------------------------------
# University Recruiting Intelligence CRM -- environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# PostgreSQL connection string used by Prisma at runtime and for migrations.
DATABASE_URL="postgresql://USER@localhost:5432/recruiting_crm?schema=public"

# Separate database used by the integration test suite. Optional; only needed
# if you run database-backed tests. It is wiped freely -- never point this at
# a database containing real data.
TEST_DATABASE_URL="postgresql://USER@localhost:5432/recruiting_crm_test?schema=public"

# --- Authentication (required) ---------------------------------------------
# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Rotating it invalidates all sessions.
SESSION_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Session lifetime in hours.
SESSION_TTL_HOURS="24"

# --- Application -----------------------------------------------------------
# Public origin of the app, used by the CSRF check on mutating requests.
# The origin the request was actually addressed to is accepted as well, so a
# forwarded port, a tunnel or a Codespace works without changing this.
APP_URL="http://localhost:3000"

# Node environment: development | test | production
NODE_ENV="development"

# --- Demo Mode -------------------------------------------------------------
# When "true", the app renders the DEMO MODE banner and enables the demo-only
# fixture source adapter, which serves synthetic records instead of making
# live network requests. Demo data is entirely fictional.
DEMO_MODE="true"

# Credentials created by `npm run db:seed` for the demo account.
# Change these before exposing the app to anyone else.
DEMO_USER_EMAIL="demo@example.com"
DEMO_USER_PASSWORD="demo-password-change-me"

# --- Source discovery / collection -----------------------------------------
# User-Agent sent with every outbound HTTP request. Identify yourself honestly
# and provide a contact address so site operators can reach you.
HTTP_USER_AGENT="UniversityRecruitingIntelligenceCRM/0.1 (+contact: you@example.com)"

# Per-request timeout in milliseconds.
HTTP_TIMEOUT_MS="15000"

# Minimum delay in milliseconds between two requests to the SAME host.
# This is a politeness control. Do not set it to 0.
HTTP_PER_HOST_DELAY_MS="1500"

# Maximum number of pages source discovery will fetch per university per run.
DISCOVERY_MAX_PAGES="60"

# Maximum crawl depth from a university's seed domains during discovery.
DISCOVERY_MAX_DEPTH="2"

# Whether to honour robots.txt during discovery and collection.
# Leave this "true". Setting it to "false" is not supported and is very likely
# to violate the terms of service of the sites you are fetching.
RESPECT_ROBOTS_TXT="true"

# Enable live outbound network requests. When "false" (the default for a fresh
# checkout), discovery and collection run only against demo fixtures, so the
# app never contacts a real university website.
ENABLE_LIVE_NETWORK="false"

# --- Optional: search-API-backed source discovery --------------------------
# Source discovery has two providers. The default is a polite, robots-aware
# crawler that needs no API key. If you have a web-search API key you may set
# these to enable the search-backed provider instead. Leaving them blank is
# fully supported.
SEARCH_PROVIDER=""          # "" (disabled) | "brave" | "serpapi"
SEARCH_API_KEY=""

# --- Optional: AI-assisted classification ----------------------------------
# The AI layer is provider-agnostic and entirely optional. With no key set,
# the app uses deterministic rule-based classifiers for every step and the
# product is fully functional. AI is never allowed to invent facts: all AI
# output is schema-validated and must cite an evidence record.
AI_PROVIDER=""              # "" (disabled) | "anthropic" | "openai" | "custom"
AI_API_KEY=""
AI_MODEL=""
AI_BASE_URL=""

# --- Pipeline defaults (also editable in the app's Settings page) ----------
# Candidates scoring at or above this discovery score enter the enrichment
# queue. Candidates below it stay discovered but are not enriched.
DISCOVERY_THRESHOLD="60"
